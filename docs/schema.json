{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UHP Harness Card",
  "description": "A Unified Harness Protocol (UHP) harness card describes one agent harness.",
  "type": "object",
  "required": ["name", "description"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name of the harness."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "One-to-two sentence summary of what the harness does."
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "description": "The harness's own website."
    },
    "docs": {
      "type": "string",
      "format": "uri",
      "description": "Documentation URL."
    },
    "github": {
      "type": "string",
      "format": "uri",
      "description": "Public source repository, if any."
    }
  }
}
